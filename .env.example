# Configurações do Antigravity e APIs
GEMINI_API_KEY=your_gemini_api_key_here
STITCH_API_KEY=your_stitch_api_key_here
GITHUB_PERSONAL_KEY=your_github_personal_token_here

# Firebase Web App (Opcional)
FIREBASE_apiKey=your_firebase_api_key
FIREBASE_authDomain=your_project.firebaseapp.com
FIREBASE_projectId=your_project_id
FIREBASE_storageBucket=your_project.firebasestorage.app
FIREBASE_messagingSenderId=your_sender_id
FIREBASE_appId=your_app_id
